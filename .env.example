# Email thông báo lead tư vấn mới (xem app/api/contact/route.ts) - để trống thì vẫn ghi
# log lead ở server, chỉ không gửi email.
RESEND_API_KEY=

# Webhook revalidate cache ảnh CMS (xem app/api/revalidate/route.ts) - PHẢI khớp ĐÚNG
# WEBSITE_REVALIDATE_SECRET đang cấu hình bên ERP backend. Sinh bằng:
#   openssl rand -base64 32
REVALIDATE_SECRET=

# Base URL của ERP backend (public API, xem lib/cms.ts) - để trống thì tự dùng
# https://app.vietdeco.com.vn (mặc định production). Chỉ cần set khi test với ERP chạy
# ở domain/port khác (vd local dev).
ERP_PUBLIC_API_BASE_URL=
